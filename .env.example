# Per-machine configuration. Copy to .env (gitignored) and edit; values here
# never override variables already exported in your shell.

# Where bulk data lives. Defaults to <repo>/data.
# On a cluster, point this at scratch storage, not $HOME (see slurm/README.md).
# KAPPA_DATA_ROOT=/path/to/large-storage/kappa

# Slurm jobs only: per-user scratch root for caches, environments and logs.
# Required by slurm/env_common.sh.
# KAPPA_SCRATCH=/scratch/your-username

# Competition slug passed to the Kaggle CLI.
# KAPPA_COMPETITION=rsna-knee-abnormality-detection
